import matplotlib.patches as patches
import matplotlib.pyplot as plt
import numpy as np


raster = np.ones((10, 10, 3))
raster[3:7, 3:7] = [0.2, 0.4, 0.8]


fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(8, 4))

ax1.imshow(raster)
ax1.set_title("Raster Representation")

ax2.add_patch(patches.Rectangle((3, 3), 4, 4, color=(0.2, 0.4, 0.8)))
ax2.set(xlim=(0, 10), ylim=(0, 10), title="Vector Representation")

plt.show()
