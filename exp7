import matplotlib.pyplot as plt
import math

xc, yc = 0, 0
rx, ry = 8, 5
x = 0
y = ry
points = []

for i in range(361):
    theta = math.radians(i)
    px = round(xc + rx * math.cos(theta))
    py = round(yc + ry * math.sin(theta))
    points.append((px, py))

x_points, y_points = zip(*points)

plt.scatter(x_points, y_points, s=10)
plt.grid()
plt.axis("equal")
plt.title("Ellipse Rasterization")
plt.show()
