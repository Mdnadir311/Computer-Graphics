import matplotlib.pyplot as plt


points = [
    [-1, -1, 3], [1, -1, 3], [1, 1, 3], [-1, 1, 3],
    [-1, -1, 5], [1, -1, 5], [1, 1, 5], [-1, 1, 5]
]
edges = [(0,1), (1,2), (2,3), (3,0), (4,5), (5,6), (6,7), (7,4), (0,4), (1,5), (2,6), (3,7)]


ortho = [(x, y) for x, y, z in points]


persp = [(x / z, y / z) for x, y, z in points]



fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(8, 4))

for p1, p2 in edges:
    ax1.plot([ortho[p1][0], ortho[p2][0]], [ortho[p1][1], ortho[p2][1]], 'b-')
    ax2.plot([persp[p1][0], persp[p2][0]], [persp[p1][1], persp[p2][1]], 'r-')

ax1.set_title("Orthographic")
ax2.set_title("Perspective")
plt.show()
