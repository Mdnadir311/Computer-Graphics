import numpy as np
import matplotlib.pyplot as plt


P = np.array([[1, 3, 2, 1],
              [1, 1, 3, 1],
              [1, 1, 1, 1]])   

T = np.array([[1,0,2],[0,1,1],[0,0,1]])      
S = np.array([[2,0,0],[0,2,0],[0,0,1]])     
R = np.array([[0,-1,0],[1,0,0],[0,0,1]])     

P2 = R @ S @ T @ P

plt.plot(P[0], P[1], 'bo-', label='Original')
plt.plot(P2[0], P2[1], 'ro-', label='Transformed')
plt.grid(); plt.axis('equal'); plt.legend()
plt.title("2D Geometric Transformation")
plt.show()

