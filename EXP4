import matplotlib.pyplot as plt
import numpy as np


pts = np.array([[1.0, 1.2, 4.0], [1.5, 1.5, 3.0], [2.0, 1.8, 2.0]])
d = 4.0


x_p, y_p = (pts[:, 0] * d) / pts[:, 2], (pts[:, 1] * d) / pts[:, 2]


fig = plt.figure(figsize=(9, 4))
ax1 = fig.add_subplot(121, projection="3d")
ax1.scatter(*pts.T, c="b", s=30)
ax1.set(title="3D Points", xlabel="X", ylabel="Y", zlabel="Z")

ax2 = fig.add_subplot(122)
ax2.plot(x_p, y_p, "ro-")
ax2.set(title="Perspective Projection", xlabel="Projected X", ylabel="Projected Y")
ax2.grid(True, ls="--")

plt.tight_layout()
plt.show()
