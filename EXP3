import matplotlib.pyplot as plt
import numpy as np

P = np.array([[1, 2, 4, 1], [1, 3, 1, 1], [1, 1, 1, 1]])

S = np.array([[2, 0, 0], [0, 2, 0], [0, 0, 1]])
R = np.array([[0, -1, 0], [1, 0, 0], [0, 0, 1]])
T = np.array([[1, 0, 4], [0, 1, 4], [0, 0, 1]])

P1, P2 = T @ R @ S @ P, S @ R @ T @ P


titles, data = (
    ["Original", "Scale-Rotate-Translate", "Translate-Rotate-Scale"],
    [P, P1, P2],
)
fig, axs = plt.subplots(1, 3, figsize=(12, 4))

for ax, t, d in zip(axs, titles, data):
    ax.plot(d[0], d[1], "b-o")
    ax.set_title(t)
    ax.grid(True)

plt.tight_layout()
plt.show()
